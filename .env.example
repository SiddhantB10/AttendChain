# ==============================================================================
# AttendChain configuration (.env.example)
#
# LOCAL:      copy this file to .env and fill it in. .env is git-ignored: never commit it.
# PRODUCTION: do NOT upload .env. Put these values in the Render dashboard
#             (render.yaml lists them and generates the random secrets for you).
#             Vercel needs NO environment variables (it only serves the web pages).
# See DEPLOYMENT.md for the step-by-step guide.
# ==============================================================================

# ---------------------------------------------------------------- Server mode
# development: demo shortcuts on, dev fallbacks allowed
# production : refuses to start with missing/insecure settings (see DEPLOYMENT.md)
APP_ENV=development
HOST=0.0.0.0
PORT=5000

# Signs login sessions. Production: REQUIRED, random, 32+ characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# How long a sign-in lasts
SESSION_HOURS=12

# Only needed if the frontend is served from a different domain WITHOUT the Vercel
# /api rewrite (comma-separated, e.g. https://attendchain.vercel.app). Leave empty otherwise.
CORS_ORIGINS=

# ------------------------------------------------------------------- Accounts
# Central admin sign-in for the web portal. Production: ADMIN_PASSWORD REQUIRED (10+ chars).
ADMIN_EMAIL=admin@attendchain.edu
ADMIN_PASSWORD=

# Optional: replaces the public demo password "faculty123" of the seeded faculty accounts
# (faculty@college.edu, hamilton@college.edu) the next time the server starts.
# On the live site, accounts still using "faculty123" cannot sign in until this is set.
FACULTY_PASSWORD=

# Optional API token for scripts / server-to-server calls (X-Admin-Token header).
# The web app never uses it. Production: random 24+ characters, or leave empty to disable.
ADMIN_TOKEN=

# ------------------------------------------------------------------- Database
# sqlite : local file (development only: cloud hosts wipe it on every restart)
# mongodb: MongoDB Atlas (required in production)
DATABASE_BACKEND=sqlite
DATABASE_PATH=backend/data/attendchain.db
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Must match the existing database name exactly (it is case-sensitive)
MONGODB_DB_NAME=attendchain

# ----------------------------------------------------------------- Blockchain
# mock  : in-memory ledger (offline demos and tests)
# local : Hardhat node at LOCAL_RPC_URL
# hedera: Hedera testnet through the Hashio JSON-RPC relay
CHAIN_MODE=mock
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
# ECDSA private key of the faculty/deployer wallet (0x + 64 hex). Keep secret.
# Create one at https://portal.hedera.com (Testnet -> ECDSA account -> EVM private key)
FACULTY_PRIVATE_KEY=
# Deployed AttendanceRegistry address (see deployments/hedera_testnet.json)
CONTRACT_ADDRESS=
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337

# ------------------------------------------------------------ Attendance rules
MIN_ATTENDANCE_PERCENT=75
# SFace cosine-similarity threshold (0.30 lenient, 0.363 balanced, 0.45 strict)
FACE_SIMILARITY_THRESHOLD=0.363

# Campus geofence: students can only mark attendance within this radius of campus.
GEOFENCE_ENABLED=true
CAMPUS_NAME=VESIT Campus, Chembur
CAMPUS_LATITUDE=19.0458788
CAMPUS_LONGITUDE=72.8892847
CAMPUS_RADIUS_METERS=150
# Reject location fixes less precise than this (metres)
GEOFENCE_MAX_ACCURACY_METERS=100

# ------------------------------------------------- Escape hatches (avoid these)
# ALLOW_EPHEMERAL_SQLITE=true   # let production run on SQLite (data is lost on restart)
# ALLOW_MOCK_FACE_ENGINE=true   # let production run without face models (accepts ANY face)
